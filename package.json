{
  "name": "sc2-trigger-recovery-ksp",
  "private": true,
  "type": "module",
  "description": "Shared-AST SC2 trigger recovery core and accepted map records",
  "scripts": {
    "build:gui": "tsc -p gui/tsconfig.json",
    "gui": "npm run build:gui && node gui/dist/server.js",
    "verify:gui": "npm run build:gui && node scripts/check-gui.mjs",
    "bundle:benchmark": "node scripts/bundle-benchmark.mjs",
    "verify:preview": "node scripts/check-unverified-preview.mjs",
    "resources:public-core": "node src/resources/fetch-public-core.mjs",
    "verify:public-core": "node scripts/check-public-core.mjs",
    "verify:public-pack": "node scripts/check-public-pack.mjs",
    "verify:gui-call-variadic": "node scripts/check-gui-call-variadic.mjs",
    "verify:condition-helper-evidence": "node scripts/check-condition-helper-evidence.mjs",
    "format": "prettier --write \"src/**/*.{mjs,js}\" \"scripts/*.mjs\" \"gui/*.ts\" \"gui/*.html\" \"gui/*.css\" \"gui/tsconfig.json\" trigger-recovery.mjs package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{mjs,js}\" \"scripts/*.mjs\" \"gui/*.ts\" \"gui/*.html\" \"gui/*.css\" \"gui/tsconfig.json\" trigger-recovery.mjs package.json .prettierrc.json",
    "verify:source": "node scripts/check-source.mjs",
    "verify:recovered": "node scripts/check-recovered-source.mjs",
    "verify:language": "node scripts/check-language-core.mjs",
    "setup:local": "python scripts/setup-local-dependencies.py",
    "verify:attribute-source": "node scripts/check-attribute-source.mjs",
    "verify:attribute-use": "node scripts/check-attribute-use-evidence.mjs",
    "verify:retained": "node scripts/check-retained-source.mjs",
    "verify:dependencies": "node scripts/check-runtime-dependencies.mjs",
    "verify:helpers": "node scripts/check-restored-helpers.mjs",
    "verify:bindings": "node scripts/check-shared-bindings.mjs",
    "verify:authored": "node scripts/check-authored-runtime.mjs",
    "verify:cli": "node scripts/check-cli-input.mjs",
    "verify:integration": "node scripts/check-converter-integration.mjs",
    "verify:attribute-integration": "node scripts/check-attribute-integration.mjs",
    "setup:public": "python scripts/fetch-public-runtime.py && npm ci --ignore-scripts && node scripts/build-public-runtime.mjs && npm run build:gui && python scripts/fetch-release-tools.py",
    "verify:preparation": "node scripts/check-map-preparation.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build-windows.ps1",
    "verify:string-append": "node scripts/check-string-append.mjs"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "acorn": "8.15.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": "./src/conversion/index.mjs"
  },
  "dependencies": {
    "@modkit/blizzard-casc": "file:.runtime/public-upstream/casc",
    "@modkit/blizzard-common-formats": "file:.runtime/public-upstream/blizzard-common-formats",
    "@modkit/blizzard-mpq": "file:.runtime/public-upstream/mpq",
    "@modkit/blizzard-starcraft2": "file:.runtime/public-upstream/starcraft2",
    "@modkit/codec-kit": "https://raw.githubusercontent.com/hometlt/modkit-extensions-blizzard/d4218ef890064108384e8b871081a02acaa86c87/vendor/modkit-codec-kit-1.0.0.tgz",
    "@modkit/core": "https://raw.githubusercontent.com/hometlt/modkit-extensions-blizzard/d4218ef890064108384e8b871081a02acaa86c87/vendor/modkit-core-0.1.0.tgz",
    "@modkit/host": "https://raw.githubusercontent.com/hometlt/modkit-extensions-blizzard/d4218ef890064108384e8b871081a02acaa86c87/vendor/modkit-host-0.1.0.tgz",
    "@modkit/sdk": "https://raw.githubusercontent.com/hometlt/modkit-extensions-blizzard/d4218ef890064108384e8b871081a02acaa86c87/vendor/modkit-sdk-0.1.0.tgz",
    "@modkit/uv": "https://raw.githubusercontent.com/hometlt/modkit-extensions-blizzard/d4218ef890064108384e8b871081a02acaa86c87/vendor/modkit-uv-1.0.0.tgz",
    "@modkit/vfs": "https://raw.githubusercontent.com/hometlt/modkit-extensions-blizzard/d4218ef890064108384e8b871081a02acaa86c87/vendor/modkit-vfs-0.1.0.tgz",
    "@rgrove/parse-xml": "4.2.3",
    "fast-xml-parser": "4.5.6",
    "modkit-extension-archives": "https://raw.githubusercontent.com/hometlt/modkit-extensions-blizzard/d4218ef890064108384e8b871081a02acaa86c87/vendor/modkit-extension-archives-1.0.0.tgz",
    "sax": "1.6.1",
    "vscode-languageserver-types": "3.18.0",
    "vscode-uri": "3.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "version": "3.1.1"
}
