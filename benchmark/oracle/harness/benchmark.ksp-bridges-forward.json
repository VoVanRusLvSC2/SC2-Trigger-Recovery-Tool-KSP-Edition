{
  "schemaVersion": 1,
  "name": "bridges-forward-pilot",
  "astOracleModule": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 60000,
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": ["adapters/modkit.mjs", "{request}"],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js"
      }
    }
  ],
  "cases": [
    {
      "id": "bridges",
      "documentKind": "map",
      "operation": "galaxy-to-triggers",
      "tags": ["real-package", "map-script", "no-gui-baseline"],
      "inputs": [
        {
          "role": "package",
          "id": "map-package",
          "path": "../artifacts/corpus-installed-2026-09-16/originals/bridges.SC2Map"
        },
        {
          "role": "script",
          "fromPackage": "map-package",
          "path": "MapScript.galaxy"
        }
      ],
      "options": { "libraryId": "Map", "verification": "semantic" }
    }
  ]
}
