{
  "schemaVersion": 1,
  "name": "allracestester-modkit-vs-ksp",
  "astOracleModule": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 3600000,
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": ["adapters/modkit.mjs", "{request}"],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js"
      }
    },
    {
      "id": "ksp",
      "command": "node",
      "args": ["adapters/ksp.mjs", "{request}"]
    }
  ],
  "cases": [
    {
      "id": "allracestester",
      "documentKind": "map",
      "operation": "galaxy-triggers-roundtrip",
      "tags": ["real-package", "map-script", "gui-baseline"],
      "inputs": [
        {
          "role": "package",
          "id": "map-package",
          "path": "../artifacts/allracestester-2026-09-25/orig"
        },
        { "role": "script", "fromPackage": "map-package", "path": "MapScript.galaxy" },
        { "role": "expected-trigger-data", "fromPackage": "map-package", "path": "Triggers" },
        { "role": "trigger-strings", "fromPackage": "map-package", "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt" }
      ],
      "options": {
        "libraryId": "Map",
        "verification": "semantic",
        "kspMap": "C:/FILES/SC2Files/Unsorted/Maps/AllRacesTester.SC2Map"
      }
    }
  ]
}
