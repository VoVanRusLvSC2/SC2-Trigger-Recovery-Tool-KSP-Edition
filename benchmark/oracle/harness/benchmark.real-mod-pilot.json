{
  "schemaVersion": 1,
  "astOracleModule": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "name": "real-folders-mod-pilot",
  "repetitions": 1,
  "timeoutMs": 60000,
  "coverageRequirements": {
    "minCases": 1,
    "minUniquePackages": 1,
    "minDocumentKinds": { "library": 1 },
    "minOperations": { "triggers-to-galaxy": 1 },
    "minTags": { "real-package": 1 }
  },
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": ["adapters/modkit.mjs", "{request}"],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js"
      }
    }
  ],
  "cases": [
    {
      "id": "folders-mod-forward",
      "documentKind": "library",
      "operation": "triggers-to-galaxy",
      "tags": ["real-package", "mod", "triggers-to-galaxy", "galaxy-ast-baseline"],
      "inputs": [
        { "role": "package", "id": "source-mod", "path": "../artifacts/Folders.SC2Mod" },
        { "role": "trigger-data", "fromPackage": "source-mod", "path": "Triggers" },
        { "role": "trigger-strings", "fromPackage": "source-mod", "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt" },
        { "role": "expected-script", "fromPackage": "source-mod", "path": "Base.SC2Data/Lib91EAF621.galaxy" },
        { "role": "expected-header", "fromPackage": "source-mod", "path": "Base.SC2Data/Lib91EAF621_h.galaxy" }
      ],
      "options": { "verification": "full" }
    }
  ]
}
