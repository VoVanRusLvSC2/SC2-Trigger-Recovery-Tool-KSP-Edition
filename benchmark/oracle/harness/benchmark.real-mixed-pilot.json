{
  "schemaVersion": 1,
  "name": "real-mixed-2",
  "astOracleModule": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 60000,
  "coverageRequirements": {
    "minCases": 2,
    "minUniquePackages": 2,
    "minDocumentKinds": {
      "map": 1,
      "mod": 1
    },
    "minOperations": {
      "galaxy-triggers-roundtrip": 2
    },
    "minTags": {
      "real-package": 2,
      "map-script": 1,
      "mod-script": 1,
      "mod-library": 1,
      "script-size-tier-1": 1,
      "script-size-tier-2": 0,
      "script-size-tier-3": 1,
      "script-size-tier-4": 0,
      "script-size-tier-5": 0,
      "gui-baseline": 1,
      "single-library-package": 1,
      "has-galaxy-header": 1,
      "has-trigger-strings": 2
    }
  },
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": [
        "adapters/modkit.mjs",
        "{request}"
      ],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../modkit-extensions-blizzard/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js"
      }
    }
  ],
  "cases": [
    {
      "id": "real-map-001",
      "documentKind": "map",
      "operation": "galaxy-triggers-roundtrip",
      "tags": [
        "real-package",
        "map-script",
        "has-trigger-strings",
        "script-size-tier-1",
        "no-gui-baseline"
      ],
      "inputs": [
        {
          "role": "package",
          "id": "map-package",
          "path": "../artifacts/corpus-installed-2026-09-16/originals/01-ChainOfAscension.SC2Map"
        },
        {
          "role": "script",
          "fromPackage": "map-package",
          "path": "MapScript.galaxy"
        },
        {
          "role": "trigger-strings",
          "fromPackage": "map-package",
          "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt"
        }
      ],
      "options": {
        "libraryId": "Map",
        "verification": "full"
      }
    },
    {
      "id": "real-mod-002",
      "documentKind": "mod",
      "operation": "galaxy-triggers-roundtrip",
      "tags": [
        "real-package",
        "mod-script",
        "mod-library",
        "single-library-package",
        "has-galaxy-header",
        "has-trigger-strings",
        "script-size-tier-3",
        "gui-baseline"
      ],
      "inputs": [
        {
          "role": "package",
          "id": "mod-package",
          "path": "../artifacts/corpus-installed-2026-09-16/originals/-cnc-data.SC2Mod"
        },
        {
          "role": "script",
          "fromPackage": "mod-package",
          "path": "Base.SC2Data/LibCNCC.galaxy"
        },
        {
          "role": "header",
          "fromPackage": "mod-package",
          "path": "Base.SC2Data/LibCNCC_h.galaxy"
        },
        {
          "role": "expected-trigger-data",
          "fromPackage": "mod-package",
          "path": "Triggers"
        },
        {
          "role": "trigger-strings",
          "fromPackage": "mod-package",
          "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt"
        }
      ],
      "options": {
        "libraryId": "CNCC",
        "verification": "full"
      }
    }
  ]
}
