{
  "schemaVersion": 1,
  "name": "original-triggers-cross-mod",
  "astOracleModule": "../modkit-extensions-blizzard/.benchmark-build/deity-fix/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 180000,
  "coverageRequirements": {
    "minCases": 2,
    "minUniquePackages": 2,
    "minDocumentKinds": { "mod": 2 },
    "minOperations": { "triggers-to-galaxy": 2 }
  },
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": ["adapters/modkit.mjs", "{request}"],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../modkit-extensions-blizzard/.benchmark-build/deity-fix/modules/triggers/services/galaxy-conversion/index.js"
      }
    }
  ],
  "cases": [
    {
      "id": "old-red-data-original-triggers",
      "documentKind": "mod",
      "operation": "triggers-to-galaxy",
      "tags": ["real-package", "original-trigger-data"],
      "inputs": [
        { "role": "package", "id": "package", "path": "../artifacts/corpus-installed-2026-09-16/originals/-old-red-data.sc2mod" },
        { "role": "trigger-data", "fromPackage": "package", "path": "Triggers" },
        { "role": "trigger-strings", "fromPackage": "package", "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt" },
        { "role": "expected-script", "fromPackage": "package", "path": "Base.SC2Data/LibRED3.galaxy" },
        { "role": "expected-header", "fromPackage": "package", "path": "Base.SC2Data/LibRED3_h.galaxy" }
      ],
      "options": { "libraryId": "RED3" }
    },
    {
      "id": "all-races-extension-original-triggers",
      "documentKind": "mod",
      "operation": "triggers-to-galaxy",
      "tags": ["real-package", "original-trigger-data"],
      "inputs": [
        { "role": "package", "id": "package", "path": "../artifacts/corpus-installed-2026-09-16/originals/AllRaces2-Extension.SC2Mod" },
        { "role": "trigger-data", "fromPackage": "package", "path": "Triggers" },
        { "role": "trigger-strings", "fromPackage": "package", "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt" },
        { "role": "expected-script", "fromPackage": "package", "path": "Base.SC2Data/LibARMP.galaxy" },
        { "role": "expected-header", "fromPackage": "package", "path": "Base.SC2Data/LibARMP_h.galaxy" }
      ],
      "options": { "libraryId": "ARMP" }
    }
  ]
}
