{
  "schemaVersion": 1,
  "name": "ice-baneling-g2t-texturemap",
  "astOracleModule": "../.wt-sc2-triggers/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 3600000,
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": [
        "adapters/modkit.mjs",
        "{request}"
      ],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../.wt-sc2-triggers-fix/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
        "MODKIT_ADAPTER_SELF_CHECK": "0"
      },
      "timeoutMs": 900000
    }
  ],
  "cases": [
    {
      "id": "ice-baneling",
      "documentKind": "map",
      "operation": "galaxy-to-triggers",
      "tags": [
        "real-package",
        "map-script",
        "triggers-stripped",
        "gui-baseline",
        "installed-mod-dependency",
        "additional-scripts-converted"
      ],
      "inputs": [
        {
          "role": "package",
          "id": "map-package",
          "path": "../artifacts/modkit-vs-ksp-final-2026-09-26/maps/Ice Baneling Escape Arctic Adventures.SC2Map"
        },
        {
          "role": "script",
          "fromPackage": "map-package",
          "path": "MapScript.galaxy"
        },
        {
          "role": "trigger-strings",
          "fromPackage": "map-package",
          "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt"
        },
        {
          "role": "game-strings",
          "fromPackage": "map-package",
          "path": "enUS.SC2Data/LocalizedData/GameStrings.txt"
        },
        {
          "role": "expected-trigger-data",
          "path": "../artifacts/test-mods-vovan/originals/Ice Baneling Escape Arctic Adventures.SC2Map/Triggers"
        },
        {
          "role": "additional-script",
          "fromPackage": "map-package",
          "path": "TextureMap.galaxy"
        }
      ],
      "options": {
        "libraryId": "Map",
        "kspMap": "../artifacts/modkit-vs-ksp-final-2026-09-26/maps/Ice Baneling Escape Arctic Adventures.SC2Map",
        "verification": "semantic",
        "convertAdditionalScripts": true
      }
    }
  ]
}
