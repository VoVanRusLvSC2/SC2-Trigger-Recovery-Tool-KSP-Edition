  "repetitions": 1,
  "timeoutMs": 3600000,
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": [
        "adapters/modkit.mjs",
        "{request}"
      ],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../.wt-sc2-triggers/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
        "MODKIT_ADAPTER_SELF_CHECK": "0"
      },
      "timeoutMs": 900000
    },
    {
      "id": "ksp",
      "command": "node",
      "args": [
        "adapters/ksp.mjs",
        "{request}"
      ],
      "timeoutMs": 7200000,
      "env": {
        "KSP_MIN_FREE_VIRTUAL_GB": "1.5"
      }
    }
  ],
