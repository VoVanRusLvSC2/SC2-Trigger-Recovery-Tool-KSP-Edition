{
  "schemaVersion": 1,
  "name": "real-mod-fix-check",
  "astOracleModule": "../modkit-extensions-blizzard/.benchmark-build/sc2-fix/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 60000,
  "coverageRequirements": {
    "minCases": 1,
    "minUniquePackages": 1,
    "minDocumentKinds": {
      "mod": 1
    }
  },
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": [
        "adapters/modkit.mjs",
        "{request}"
      ],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../modkit-extensions-blizzard/.benchmark-build/sc2-fix/modules/triggers/services/galaxy-conversion/index.js"
      }
    }
  ],
  "cases": [
    {
      "id": "real-mod-005",
      "documentKind": "mod",
      "operation": "galaxy-triggers-roundtrip",
      "options": {
        "libraryId": "CNCC",
        "verification": "semantic"
      },
      "inputs": [
        {
          "role": "package",
          "id": "mod-package",
          "path": "../artifacts/corpus-installed-2026-09-16/originals/-cnc-data.SC2Mod"
        },
        {
          "role": "script",
          "fromPackage": "mod-package",
          "path": "Base.SC2Data/LibCNCC.galaxy"
        },
        {
          "role": "header",
          "fromPackage": "mod-package",
          "path": "Base.SC2Data/LibCNCC_h.galaxy"
        },
        {
          "role": "expected-trigger-data",
          "fromPackage": "mod-package",
          "path": "Triggers"
        },
        {
          "role": "trigger-strings",
          "fromPackage": "mod-package",
          "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt"
        }
      ]
    }
  ]
}
