  "repetitions": 1,
  "timeoutMs": 60000,
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": [
        "adapters/modkit.mjs",
        "{request}"
      ],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../.wt-sc2-triggers-fix/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
        "MODKIT_ADAPTER_OWN_LIBRARIES": "1"
      },
      "timeoutMs": 900000
    }
  ],
  "cases": [
    {
      "id": "complex-mod-001",
      "documentKind": "mod",
      "operation": "galaxy-triggers-roundtrip",
      "tags": [
        "real-package",
        "mod-script",
        "mod-library",
        "single-library-package",
        "has-galaxy-header",
        "has-trigger-strings",
        "script-size-tier-1",
        "gui-baseline"
      ],
      "inputs": [
        {
          "role": "package",
          "id": "mod-package",
          "path": "../artifacts/corpus-installed-2026-09-16/originals/AllRaces2-Extension-HTXL.SC2Mod"
        },
        {
          "role": "script",
          "fromPackage": "mod-package",
          "path": "Base.SC2Data/LibARMP.galaxy"
        },
        {
          "role": "header",
          "fromPackage": "mod-package",
          "path": "Base.SC2Data/LibARMP_h.galaxy"
        },
        {
          "role": "expected-trigger-data",
          "fromPackage": "mod-package",
          "path": "Triggers"
        },
        {
          "role": "original-trigger-data",
          "fromPackage": "mod-package",
          "path": "Triggers"
        },
        {
          "role": "trigger-strings",
          "fromPackage": "mod-package",
          "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt"
        }
      ],
      "options": {
        "libraryId": "ARMP",
        "verification": "semantic"
      }
    },
