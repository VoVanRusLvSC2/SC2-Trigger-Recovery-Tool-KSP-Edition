{
  "schemaVersion": 1,
  "astOracleModule": "../.wt-sc2-triggers/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 3600000,
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": [
        "adapters/modkit.mjs",
        "{request}"
      ],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../.wt-sc2-triggers/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
        "MODKIT_ADAPTER_SELF_CHECK": "0"
      },
      "timeoutMs": 900000
    },
    {
      "id": "ksp",
      "command": "node",
      "args": [
        "adapters/ksp.mjs",
        "{request}"
      ],
      "timeoutMs": 7200000,
      "env": {
        "KSP_MIN_FREE_VIRTUAL_GB": "1.5"
      }
    }
  ],
  "name": "modkit-vs-ksp-final-smoke",
  "cases": [
    {
      "id": "bridges",
      "documentKind": "map",
      "operation": "galaxy-triggers-roundtrip",
      "tags": [
        "real-package",
        "map-script",
        "no-gui-baseline"
      ],
      "inputs": [
        {
          "role": "package",
          "id": "map-package",
          "path": "../artifacts/corpus-installed-2026-09-16/originals/bridges.SC2Map"
        },
        {
          "role": "script",
          "fromPackage": "map-package",
          "path": "MapScript.galaxy"
        },
        {
          "role": "trigger-strings",
          "fromPackage": "map-package",
          "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt"
        }
      ],
      "options": {
        "libraryId": "Map",
        "verification": "semantic",
        "kspMap": "../artifacts/corpus-installed-2026-09-16/originals/bridges.SC2Map"
      }
    }
  ]
}
