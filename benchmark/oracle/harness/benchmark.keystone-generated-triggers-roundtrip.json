        "MODKIT_CONVERSION_MODULE": "../modkit-extensions-blizzard/.benchmark-build/sc2-fix/modules/triggers/services/galaxy-conversion/index.js"
      }
    }
  ],
  "cases": [
    {
      "id": "keystone-generated-triggers",
      "documentKind": "map",
      "operation": "galaxy-triggers-roundtrip",
      "tags": ["real-package", "generated-trigger-data"],
      "inputs": [
        { "role": "package", "id": "package", "path": "../artifacts/test-mods-vovan/originals/KeyStone.SC2Map" },
        { "role": "script", "fromPackage": "package", "path": "MapScript.galaxy" },
        { "role": "trigger-strings", "fromPackage": "package", "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt" }
      ],
      "options": { "libraryId": "Map", "verification": "semantic" }
    }
  ]
}
