    "minUniquePackages": 1,
    "minDocumentKinds": { "map": 1 },
    "minOperations": { "galaxy-triggers-roundtrip": 1 }
  },
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": ["adapters/modkit.mjs", "{request}"],
