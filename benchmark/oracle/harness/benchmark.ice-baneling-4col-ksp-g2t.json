{
  "schemaVersion": 1,
  "name": "ice-baneling-4col-ksp-g2t",
  "astOracleModule": "../.wt-sc2-triggers/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 3600000,
  "converters": [
    {
      "id": "ksp",
      "command": "node",
      "args": [
        "adapters/ksp.mjs",
        "{request}"
      ],
      "env": {
        "KSP_MIN_FREE_VIRTUAL_GB": "1.5"
      },
      "timeoutMs": 7200000
    }
  ],
  "cases": [
    {
      "id": "ice-baneling-no-texturemap",
      "documentKind": "map",
      "operation": "galaxy-to-triggers",
      "tags": [
        "real-package",
        "map-script",
        "triggers-stripped",
        "installed-mod-dependency",
        "texturemap-removed"
      ],
      "inputs": [
        {
          "role": "package",
          "id": "map-package",
          "path": "../artifacts/modkit-vs-ksp-final-2026-09-26/maps-no-texturemap/Ice Baneling Escape Arctic Adventures.SC2Map"
        },
        {
          "role": "script",
          "fromPackage": "map-package",
          "path": "MapScript.galaxy"
        },
        {
          "role": "trigger-strings",
          "fromPackage": "map-package",
          "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt"
        },
        {
          "role": "game-strings",
          "fromPackage": "map-package",
          "path": "enUS.SC2Data/LocalizedData/GameStrings.txt"
        },
        {
          "role": "expected-trigger-data",
          "path": "../artifacts/test-mods-vovan/originals/Ice Baneling Escape Arctic Adventures.SC2Map/Triggers"
        }
      ],
      "options": {
        "libraryId": "Map",
        "verification": "semantic",
        "kspMap": "../artifacts/modkit-vs-ksp-final-2026-09-26/maps-no-texturemap/Ice Baneling Escape Arctic Adventures.SC2Map"
      }
    }
  ]
}
