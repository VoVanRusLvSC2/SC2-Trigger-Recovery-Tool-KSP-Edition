{
  "schemaVersion": 1,
  "name": "include-check",
  "astOracleModule": "../.wt-sc2-triggers/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js",
  "repetitions": 1,
  "timeoutMs": 1200000,
  "converters": [
    {
      "id": "modkit",
      "command": "node",
      "args": ["adapters/modkit.mjs", "{request}"],
      "env": {
        "MODKIT_CONVERSION_MODULE": "../.wt-sc2-triggers/starcraft2/dist/modules/triggers/services/galaxy-conversion/index.js"
      },
      "timeoutMs": 1200000
    }
  ],
  "cases": [
    {
      "id": "ice-baneling-forward",
      "documentKind": "map",
      "operation": "triggers-to-galaxy",
      "tags": ["real-package", "include-check"],
      "inputs": [
        { "role": "package", "id": "source-map", "path": "../artifacts/test-mods-vovan/originals/Ice Baneling Escape Arctic Adventures.SC2Map" },
        { "role": "trigger-data", "fromPackage": "source-map", "path": "Triggers" },
        { "role": "expected-script", "fromPackage": "source-map", "path": "MapScript.galaxy" },
        { "role": "trigger-strings", "fromPackage": "source-map", "path": "enUS.SC2Data/LocalizedData/TriggerStrings.txt" }
      ],
      "options": { "libraryId": "Map", "verification": "full" }
    }
  ]
}
